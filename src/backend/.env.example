# Copy to .env for local development. Never commit .env or real values.
# In Azure these are App Service settings; secrets are Key Vault references.

PORT=5000
NODE_ENV=development

# Public client URL used in verification/reset links, and allowed CORS origins (comma separated).
APP_BASE_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# --- Azure SQL ---
DB_SERVER=your-server.database.windows.net
DB_NAME=lostfound
# DB_AUTH=aad uses the App Service managed identity (or az login locally).
# DB_AUTH=sql uses DB_USER and DB_PASSWORD.
# DB_AUTH=windows uses Windows integrated auth (local SQL Express, e.g. DB_SERVER=.\SQLEXPRESS).
DB_AUTH=aad
DB_USER=
DB_PASSWORD=
# Separate database used by Jest. Tests refuse to run against DB_NAME.
DB_NAME_TEST=lostfound_test

# --- Secrets (Key Vault in Azure) ---
JWT_SECRET=
# 64 hex characters (32 bytes) for AES-256-GCM claim evidence encryption.
EVIDENCE_ENCRYPTION_KEY=

# --- Azure Blob Storage ---
# Account name; access uses managed identity. Containers are private.
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER_LISTINGS=listing-photos
STORAGE_CONTAINER_EVIDENCE=claim-evidence
# Local dev only: an Azurite or account connection string. Leave blank in Azure.
STORAGE_CONNECTION_STRING=

# --- Azure Communication Services Email (leave blank to skip delivery) ---
ACS_ENDPOINT=
EMAIL_FROM=

# --- Matching ---
# Minimum match score (0 to 1). Default 0.6
MATCH_THRESHOLD=0.6

# --- Application Insights (optional) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
